# 复制为 .env 后填入真实 Key（.env 已 gitignore）
#
# GLM Coding Plan（订阅额度）：
#   ZAI_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
#   ZAI_MODEL=glm-4.7   # 或 glm-5.3 / glm-5-turbo
#
# 按量计费（账户余额 / 资源包）：
#   ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
#   ZAI_MODEL=glm-4
#
# 若报错 1113「余额不足」：多半是用了 Coding Plan Key 却打到 paas/v4，
# 或 Coding 额度用尽，或 Key 类型与 baseURL 不匹配。

ZAI_API_KEY=
ZAI_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
ZAI_MODEL=glm-4.7

# Runner 后端默认值：cursor | pi（可被各專案 .pm-ai/project.yml 的 runner_provider 覆盖）
# - cursor：@cursor/sdk，需要 CURSOR_API_KEY（不能用 GLM Key）
# - pi：@earendil-works/pi-coding-agent（进程内 Agent），复用上面的 ZAI_API_KEY
#       bigmodel.cn → zai-coding-cn；api.z.ai → zai
#       也可设 PI_PROVIDER / PI_MODEL 覆盖
# 历史值 opencode 会自动映射为 pi。
# 也可在 Auto 页「任务执行器」为单个项目切换，无需改此文件。
RUNNER_PROVIDER=cursor

# Cursor SDK Runner
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
CURSOR_RUNNER_CONCURRENCY=1

# Pi Agent SDK（可选覆盖）
# PI_PROVIDER=zai-coding-cn
# PI_MODEL=glm-4.7
# PI_THINKING_LEVEL=off
# PI_RUNNER_CONCURRENCY=1
# PI_PROMPT_MAX_ATTEMPTS=3

# 局域網訪問（可選，預設僅本機 127.0.0.1）
# HOST=0.0.0.0
# PM_AI_LAN_HOST=192.168.1.100  # 可選，指定對外展示的 LAN IP（多網卡時）
