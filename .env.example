# 复制为 .env 后填入真实 Key（.env 已 gitignore）
#
# GLM Coding Plan（订阅额度）：
#   ZAI_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
#   ZAI_MODEL=glm-4.7   # 或 glm-5.3 / glm-5-turbo
#
# 按量计费（账户余额 / 资源包）：
#   ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
#   ZAI_MODEL=glm-4
#
# 若报错 1113「余额不足」：多半是用了 Coding Plan Key 却打到 paas/v4，
# 或 Coding 额度用尽，或 Key 类型与 baseURL 不匹配。

ZAI_API_KEY=
ZAI_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
ZAI_MODEL=glm-4.7

# Runner 后端：cursor | opencode
# - cursor：@cursor/sdk，需要 CURSOR_API_KEY（不能用 GLM Key）
# - opencode：@opencode-ai/sdk（createOpencodeServer + session.prompt）
#             复用上面的 ZAI_API_KEY；本机需安装 opencode CLI（SDK 会拉起 serve）
#             安装：curl -fsSL https://opencode.ai/install | bash  或  npm i -g opencode-ai
# OPENCODE_BIN=  # 可选，opencode 可执行文件的绝对路径
RUNNER_PROVIDER=cursor

# Cursor SDK Runner
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
CURSOR_RUNNER_CONCURRENCY=1

# OpenCode SDK（可选覆盖）
# OPENCODE_PROVIDER=zai-coding-plan
# OPENCODE_MODEL_REF=zai-coding-plan/glm-4.7
# OPENCODE_SERVER_TIMEOUT_MS=20000
# 多个 opencode serve 会抢同一份 ~/.local/share/opencode/opencode.db，并发建表会失败。
# 默认串行；若任务已用 worktree 隔离，可再调高。
# OPENCODE_RUNNER_CONCURRENCY=1
